# Copy this file to .env in this directory. Never commit .env.
PORT=3001

# Supabase development project -> Connect -> Session pooler (port 5432).
# Replace placeholders; URL-encode special characters in the database password.
# Keep schema=public. This URL is also used by Prisma CLI (session mode).
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?schema=public&sslmode=require&sslaccept=strict"

# Official public Supabase CA, included in this project (not a credential).
# This path is resolved relative to apps/api, independently of the working directory.
DATABASE_CA_CERT_PATH="certs/supabase-ca.crt"

# Supabase -> Project settings -> API. No JWT secret / secret key is needed.
# JWT issuer and JWKS URL are derived from this fixed project URL.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_WITH_YOUR_PUBLISHABLE_KEY"
