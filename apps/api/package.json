{
  "name": "@sushi-session/api",
  "version": "0.0.1",
  "description": "API de Sushi Session",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "pnpm prisma:generate && nest start",
    "start:dev": "pnpm prisma:generate && nest start --watch",
    "start:debug": "pnpm prisma:generate && nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware --deny-warnings src/",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "pnpm build && node dist/prisma/check-connection.js",
    "test:config": "pnpm build && node --test test/environment.test.mjs",
    "test:auth": "pnpm build && node --test test/auth-jwt.test.mjs test/auth-http.test.mjs",
    "test:auth:live": "pnpm build && node scripts/verify-auth-development.mjs",
    "test:visits": "pnpm build && node --test --test-concurrency=1 test/visits-persistence.integration.test.mjs test/visits-http.integration.test.mjs",
    "test:visits:live": "pnpm build && node scripts/verify-visits-development.mjs",
    "test:merchant": "pnpm build && node --test test/merchant-http.integration.test.mjs",
    "test:dev-qr": "pnpm build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/dev-qr.integration.test.mjs",
    "test:persistence": "pnpm build && node --test --test-concurrency=1 test/persistence.integration.test.mjs test/prisma.integration.test.mjs",
    "db:migrate:dev": "pnpm build && node scripts/migrate-development.mjs deploy",
    "db:status": "pnpm build && node scripts/migrate-development.mjs status"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.4",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "jsqr": "1.4.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pngjs": "7.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "qrcode": "1.5.4",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
